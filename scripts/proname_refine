   rm -r ${clustering_method}_clusters
   find . -maxdepth 1 -type f -name "*_seq_count" -exec rm {} +
else
   mkdir -p cluster_seq_count_folder
   find . -maxdepth 1 -type f -name "*_seq_count" -exec mv {} cluster_seq_count_folder \;
fi

rm clusters_seqids_linking_table
rm Global_table
rm polisher_consensus_seqs.fasta
find /data -maxdepth 1 -type d -name '.temp_dorado_model-*' -exec rm -rf {} +
find "${clustering_method}_clusters" -maxdepth 1 -type d -name 'tmp_dorado_*' -exec rm -rf {} +
find . -maxdepth 1 -type d -name '.temp_dorado_model-*' -exec rm -rf {} +
if [ -n "${DORADO_MODELS_DIR:-}" ]
then
   rm -rf "${DORADO_MODELS_DIR}" 2>/dev/null
fi


# Remove clustering checkpoint after a successful full run
rm -f "${cluster_checkpoint}"

# Unset variables
unset HQ_fastq
unset clustering_method
unset clustering_id
unset clustering_threads
unset fastq_folder
unset n_subsampled_reads
unset polisher_batchsize
unset polisher_threads
unset polisher_model
unset polisher
unset chimera_db
unset qiime2_import
unset delete_non_essential
unset chimera_method
unset ARCH
unset verbose
unset cluster_checkpoint
